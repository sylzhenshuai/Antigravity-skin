      { "deg": 112.5, "row": 9, "col": 5, "label": "right-down-right" },
      { "deg": 135.0, "row": 9, "col": 6, "label": "down-right" },
      { "deg": 157.5, "row": 9, "col": 7, "label": "down-down-right" },
      { "deg": 180.0, "row": 10, "col": 0, "label": "down" },
      { "deg": 202.5, "row": 10, "col": 1, "label": "down-down-left" },
      { "deg": 225.0, "row": 10, "col": 2, "label": "down-left" },
      { "deg": 247.5, "row": 10, "col": 3, "label": "left-down-left" },
      { "deg": 270.0, "row": 10, "col": 4, "label": "left" },
      { "deg": 292.5, "row": 10, "col": 5, "label": "left-up-left" },
      { "deg": 315.0, "row": 10, "col": 6, "label": "up-left" },
      { "deg": 337.5, "row": 10, "col": 7, "label": "up-up-left" }
    ]
  }
}
