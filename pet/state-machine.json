{
  "name": "Doraemon Animation State Machine",
  "version": "2.0.0",
  "spriteSheet": {
    "format": "v2-atlas",
    "width": 1536,
    "height": 2288,
    "columns": 8,
    "rows": 11,
    "frameWidth": 192,
    "frameHeight": 208
  },
  "defaultState": "idle",
  "states": {
    "idle": {
      "description": "待机空闲：原地轻柔呼吸起伏，伴随偶尔眨眼与尾巴微摆",
      "row": 0,
      "frameCount": 6,
      "durations": [280, 110, 110, 140, 140, 320],
      "loop": true,
      "restingSlowFactor": 6,
      "nextState": null,
      "agentTrigger": "agent:idle",
      "vfx": null
    },
    "thinking": {
      "description": "思考推理：头顶插入竹蜻蜓（Bamboo-Copter）高速旋转，身体悬浮上下微晃浮动",
      "row": 8,
      "frameCount": 6,
      "durations": [140, 140, 140, 140, 140, 260],
      "loop": true,
      "nextState": null,
      "agentTrigger": "agent:thinking",
      "motion": {
        "type": "levitate",
        "amplitudeY": 8,
        "frequencyMs": 1400,
        "rotationDeg": 2.5
      },
      "vfx": {
        "type": "bamboo-copter-rotor",
        "position": "head-top",
        "speed": "fast"
      }
    },
    "running": {
      "description": "工具调用/写文件/执行命令：双手伸入四次元口袋快速翻找，伴随金色星芒与代码粒子",
      "row": 7,
      "frameCount": 6,
      "durations": [120, 120, 120, 120, 120, 220],
      "loop": true,
      "nextState": null,
      "agentTrigger": "agent:tool_call",
      "motion": {
        "type": "rummage",
        "bodyJiggle": true
      },
      "vfx": {
        "type": "golden-sparkles",
        "position": "pocket-front",
        "colors": ["#FFD000", "#FFE066", "#00A0E9"],
        "ratePerSec": 14
      }
    },
    "success": {
      "description": "任务成功/编译通过：双手捧出并吃掉铜锣烧，头顶升起跳跃音符与高兴爱心",
      "row": 4,
      "frameCount": 5,
      "durations": [140, 140, 140, 140, 280],
      "loop": false,
      "nextState": "idle",
      "agentTrigger": "agent:success",
      "motion": {
        "type": "joy-hop",
        "jumpHeight": 12
      },
      "vfx": {
        "type": "floating-emotes",
        "emotes": ["dorayaki", "heart", "musical-note"],
        "durationMs": 1800
      }
    },
    "error": {
      "description": "运行报错/异常终止：双眼变成旋转螺旋蚊香眼，冷汗滑落，身体失衡剧烈左右微晃",
      "row": 5,
      "frameCount": 8,
      "durations": [130, 130, 130, 130, 130, 130, 130, 240],
      "loop": false,
      "iterations": 2,
      "nextState": "waiting",
      "agentTrigger": "agent:error",
      "motion": {
        "type": "dizzy-shake",
        "shakeX": 6
      },
      "vfx": {
        "type": "sweat-drops",
        "position": "head-side",
        "color": "#38BDF8"
      }
    },
    "waiting": {
      "description": "等待指令/用户审批：充满期待地望向对话框，双手搭在口袋上",
      "row": 6,
      "frameCount": 6,
      "durations": [150, 150, 150, 150, 150, 260],
      "loop": true,
      "nextState": null,
      "agentTrigger": "agent:waiting_for_user",
      "vfx": null
    },
    "click_interaction": {
      "description": "点击微交互：害羞脸红或从口袋掏出粉红任意门探头微笑",
      "row": 3,
      "frameCount": 4,
      "durations": [140, 140, 140, 280],
      "loop": false,
      "nextState": "idle",
      "agentTrigger": "user:click",
      "motion": {
        "type": "shy-bounce"
      },
      "vfx": {
        "type": "anywhere-door-sparkle",
        "blushColor": "#FF3B30",
        "durationMs": 1200
      }
    }
  },
  "lookTracking": {
